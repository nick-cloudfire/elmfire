# Regenerable repository-level runtime and scratch artifacts
/output/
/tmp/
**/tex-cache/

# Zenodo upload bundles and explicit per-case download caches.
# Keep dataset manifests, metadata worksheets and staging scripts tracked.
/zenodo/dist/
/cases/Validation/landscape_scale/*/data/.zenodo-cache/
/zenodo/datasets/*/data/.zenodo-cache/
/zenodo/datasets/*/data/archive_payload/
/zenodo/datasets/*/data/provenance/archive/
# Retired source collection and legacy case generator.
/cases/Validation/GOFER/

# Generated input rasters retained outside version control for these cases
cases/Verification/unit_tests/*/data/

# Runtime directories removed by make clean. Report figures are deliberately
# not ignored because they are inputs to the standalone case reports.
/cases/Verification/*/CASE*/logs/
/cases/Verification/*/CASE*/scratch/
/cases/Validation/*/*/logs/
/cases/Validation/*/*/scratch/

# make clean removes raw simulation products but retains report-supporting JSON.
# Keep the outputs directory visible so the JSON exceptions can be tracked.
/cases/Verification/*/CASE*/outputs/*
!/cases/Verification/*/CASE*/outputs/*.json
/cases/Validation/*/*/outputs/*
!/cases/Validation/*/*/outputs/*.json

# Every active verification variant tree is regenerated by its case-local
# preprocessor.  Source definitions and special namelist templates belong
# outside variants/ (for example under scripts/namelists/).
cases/Verification/unit_tests/CASE*/variants/
cases/Verification/coupling_tests/CASE*/variants/

# Regenerable inputs for the portable Adam successors
cases/Verification/coupling_tests/CASE30_MIT/data/
cases/Verification/coupling_tests/CASE31_PFT/data/
cases/Verification/coupling_tests/CASE32_RCV/data/
cases/Verification/coupling_tests/CASE33_SDO/data/

# Frozen fuel tables for the Rothermel sweep cases remain source material.
!cases/Verification/unit_tests/CASE3[4-9]_*/data/
!cases/Verification/unit_tests/CASE3[4-9]_*/data/misc/
!cases/Verification/unit_tests/CASE3[4-9]_*/data/misc/fuel_models.csv
!cases/Verification/unit_tests/CASE41_CFP/data/
!cases/Verification/unit_tests/CASE41_CFP/data/misc/
!cases/Verification/unit_tests/CASE41_CFP/data/misc/fuel_models.csv

!cases/Verification/coupling_tests/CASE40_WSD/data/misc/
!cases/Verification/coupling_tests/CASE40_WSD/data/misc/fuel_models.csv
!cases/Verification/coupling_tests/CASE42_WAF/data/misc/
!cases/Verification/coupling_tests/CASE42_WAF/data/misc/fuel_models.csv

# Frozen WU-E fuel tables are source inputs; only generated variant copies are ignored.
!cases/Verification/coupling_tests/CASE1[01249]_*/data/
!cases/Verification/coupling_tests/CASE1[01249]_*/data/misc/
!cases/Verification/coupling_tests/CASE1[01249]_*/data/misc/*.csv
# CASE11 uses the built-in surface table; keep an old generated copy untracked.
cases/Verification/coupling_tests/CASE11_WSC/data/misc/fuel_models.csv
!cases/Verification/coupling_tests/CASE4[3-9]_*/data/
!cases/Verification/coupling_tests/CASE4[3-9]_*/data/misc/
!cases/Verification/coupling_tests/CASE4[3-9]_*/data/misc/*.csv

# Validation source data live in the checksummed per-fire Zenodo bundles.
# Keep case-local manifests, configurations, restore scripts and report evidence.
# These rules also cover restored optional historical outputs and older inputs.
/cases/Validation/landscape_scale/*/data/archive_payload/
/cases/Validation/landscape_scale/*/data/viirs_observation/
/cases/Validation/landscape_scale/*/data/provenance/archive/
/cases/Validation/landscape_scale/*/data/fuels_and_topography/
/cases/Validation/landscape_scale/*/data/weather/
/cases/Validation/landscape_scale/*/data/misc/

# Canonical input folders restored from per-fire datasets.
/zenodo/datasets/*/data/weather/
/zenodo/datasets/*/data/fuels_and_topography/
/zenodo/datasets/*/data/misc/

# Comparison observations restored from the checksummed per-fire archives.
/cases/Validation/landscape_scale/*/data/observation/
/zenodo/datasets/*/data/observation/
