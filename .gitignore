control_files
DEPRECATED
fuel
input_decks
/inputs
misc
outputs
scratch
work
config/wui_inputs

# ============================================================
# Runs
# ============================================================
forecasts/runs
runs/forecasts/archive
runs/forecasts/runs
runs/hindcasts/log
runs/hindcasts/runs
runs/potential/part*
runs/potential/timeseries*
runs/potential/zones
runs/risk/runs
runs/risk/template/config

# ============================================================
# Examples — large or generated content
# ============================================================
examples/CalibrateMemopt/
examples/long/
# Keep the outputs/ and scratch/ folders for examples (via .gitkeep) but
# ignore their contents. The bare `outputs`/`scratch` rules above exclude the
# directories globally, so re-include the example dirs, then re-exclude their
# contents while preserving the .gitkeep placeholders.
!examples/*/outputs/
!examples/*/scratch/
!examples/*/*/outputs/
!examples/*/*/scratch/
examples/*/outputs/*
examples/*/scratch/*
examples/*/*/outputs/*
examples/*/*/scratch/*
!examples/*/outputs/.gitkeep
!examples/*/scratch/.gitkeep
!examples/*/*/outputs/.gitkeep
!examples/*/*/scratch/.gitkeep
examples/smoke/smoke/gdas1.jul25.w1
examples/smoke/MESSAGE.*
examples/smoke/VMSDIST.*
examples/smoke/WARNING.*
examples/smoke/STARTUP

# ============================================================
# Validation, verification & tutorials
# ============================================================
# b064a8e trimmed this branch to the WUINITY-relevant subset and dropped these
# trees from version control. They are still useful to keep on disk for local
# runs, so ignore them wholesale rather than per-case: without this, every local
# test case shows up as untracked and gets swept back in by an "add all".
validation/
verification/
tutorials/

# ============================================================
# Tooling
# ============================================================
ask_rag.py
index_repo.py
.rag_db
rag_db

# ============================================================
# Logs & secrets
# ============================================================
.webui_secret_key
log.txt

# ============================================================
# Docker
# ============================================================
docker_shared_folder

# Unity generates one of these per file when this repo sits under a Unity Assets/ folder.
# They belong to the parent project, not here.
*.meta
