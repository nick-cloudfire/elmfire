# ============================================================
# Build artifacts
# ============================================================
*.backup
*.bak
*.exe
*.lock
*.manifest
*.mod
*.obj
*.old
*.pdb
BuildLog.*
# make_windows.bat's output tree. The *.exe/*.obj/*.mod/*.pdb rules above cover
# most of it, but not the Intel redistributables the build stages next to the
# binaries (impi.dll, libiomp5md.dll), so ignore the whole tree.
build/windows/bin/
build/windows/obj/

# ============================================================
# GIS / binary rasters
# ============================================================
*.aux.xml
*.bil
*.hdr

